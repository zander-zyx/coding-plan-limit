{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plan Limit",
  "version": "0.3.11",
  "identifier": "com.zander.coding-plan-limit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Plan Limit",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "popup",
        "url": "popup.html",
        "width": 280,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
